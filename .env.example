# Discord Bot Configuration
# Get these from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
DISCORD_APPLICATION_ID=your_application_id_here

# Optional: dev guild ID for instant slash command registration
# Leave empty in production (global commands take up to 1 hour to propagate)
DISCORD_DEV_GUILD_ID=

# Optional: bot owner user ID for admin commands
DISCORD_OWNER_ID=

# Future: Database connections (uncomment when added)
# DATABASE_URL=postgresql://user:password@host:5432/idletime
# REDIS_URL=redis://default:password@host:6379
