{
  "name": "idletime",
  "version": "0.0.1",
  "description": "Cozy medieval cooperative slow-MMO Discord bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @idletime/bot dev",
    "build": "pnpm --filter @idletime/db db:generate:prod",
    "start": "pnpm --filter @idletime/bot start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @idletime/bot test"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.3.0"
}
